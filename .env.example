SLACK_BOT_TOKEN=xoxb-xxxxxxxx
SLACK_APP_TOKEN=xapp-xxxxxxxx

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxx

# 任意。claude コマンドが PATH に無い場合のみ指定
# CLAUDE_BIN=/path/to/claude
# 任意。タスク化トリガーのリアクション絵文字名(デフォルト: memo = 📝のみ)。
# カンマ区切りで複数指定可(例: memo,white_check_mark,bookmark)。TASKIFY_EMOJI(単数)でも指定可。
# TASKIFY_EMOJIS=memo,white_check_mark,bookmark

# Microsoft Teams/Outlook連携(F-101/103/104)。未設定ならどちらもポーリングは自動的に無効化される。
# Azure Portal > アプリの登録 で取得する値。web/.env.local.example の同名項目と同じ値を使う。
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Gmail連携(F-104相当)のポーリング用。未設定ならGmailポーリングは自動的に無効化される。
# SITE_URL: web側(ローカルの http://localhost:3001 でも公開済みのCloudflare URLでもよい)。
# POLL_SECRET: web/.env.local.example の同名項目と同じ値(POST /api/poll-gmail の認証に使う)。
# SITE_URL=
# POLL_SECRET=
