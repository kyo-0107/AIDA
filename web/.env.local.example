# ブラウザにも渡ってよい値(NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# サーバー専用。ブラウザに絶対渡さない(招待メール送信などの特権操作でのみ使う)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Microsoft Teams/Outlook連携(F-101/103/104)。Azure Portal > アプリの登録 で取得する。
# リダイレクトURIは Azure 側に以下の2つを両方登録しておくこと:
#   http://localhost:3001/api/integrations/teams/callback
#   http://localhost:3001/api/integrations/outlook/callback
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Gmail連携。Google Cloud Console > APIとサービス > 認証情報 で取得する。
# リダイレクトURIは `http://localhost:3001/api/gmail/callback` を登録しておくこと。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/callback
# `openssl rand -hex 32` で生成した64桁の16進文字列(OAuthトークンの暗号化に使う)
ENCRYPTION_KEY=
# /api/poll-gmail を手動実行/外部cronから叩くときに Authorization: Bearer <値> で照合する秘密の文字列
POLL_SECRET=
